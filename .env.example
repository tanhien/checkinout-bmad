# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://hotel:hotel@localhost:5433/hotel_dev

# ─── Auth Secrets (min 32 bytes each) ──────────────────
STAFF_JWT_SECRET=replace-with-min-32-char-random-string-here
GUEST_JWT_SECRET=replace-with-min-32-char-random-string-here-2

# ─── Redis (Upstash) ───────────────────────────────────
UPSTASH_REDIS_URL=https://your-instance.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token

# ─── Email (Resend) ────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ─── File Storage (Cloudflare R2) ──────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET=hotel-management
CLOUDFLARE_R2_PUBLIC_URL=https://your-bucket.your-domain.com

# ─── PII Encryption (AES-256-GCM, 64 hex chars = 32 bytes) ─
PII_ENCRYPTION_KEY=replace-with-64-char-hex-string-00000000000000000000000000000000

# ─── App URLs ──────────────────────────────────────────
NEXT_PUBLIC_STAFF_URL=http://localhost:3001
NEXT_PUBLIC_BOOKING_URL=http://localhost:3000

# ─── Kiosk (Vite env vars, prefix VITE_) ───────────────
VITE_STAFF_API_URL=http://localhost:3001
VITE_BOOKING_API_URL=http://localhost:3000
VITE_KIOSK_API_KEY=replace-with-property-kiosk-api-key
VITE_KIOSK_ID=kiosk-lobby-01
